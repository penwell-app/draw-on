{
    "name": "@penwell/draw-on",
    "version": "1.0.0",
    "description": "Make any SVG draw itself. Zero-dependency stroke animation with <use>/<symbol> support, fills and labels that fade in, scrubbing, scroll, a pen nib, hand-drawn mode, CSS-only animated SVG export and WebM recording. React, Web Component and vanilla.",
    "keywords": [
        "svg",
        "svg-animation",
        "animation",
        "line-drawing",
        "stroke-animation",
        "path-animation",
        "draw",
        "draw-svg",
        "handwriting",
        "signature",
        "sketch",
        "hand-drawn",
        "reveal",
        "scroll-animation",
        "react",
        "web-component",
        "custom-element",
        "mermaid",
        "excalidraw",
        "icons",
        "logo-animation",
        "animated-svg",
        "vivus",
        "vivus-alternative",
        "record",
        "webm",
        "scrubbable"
    ],
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./core": {
            "import": {
                "types": "./dist/core.d.ts",
                "default": "./dist/core.js"
            },
            "require": {
                "types": "./dist/core.d.cts",
                "default": "./dist/core.cjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react.d.ts",
                "default": "./dist/react.js"
            },
            "require": {
                "types": "./dist/react.d.cts",
                "default": "./dist/react.cjs"
            }
        },
        "./element": {
            "import": {
                "types": "./dist/element.d.ts",
                "default": "./dist/element.js"
            },
            "require": {
                "types": "./dist/element.d.cts",
                "default": "./dist/element.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "demo-annotate.gif",
        "demo-diagram.gif",
        "demo-notebook.gif",
        "draw-on.svg"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/penwell-app/draw-on.git"
    },
    "homepage": "https://draw-on-nu.vercel.app/",
    "bugs": {
        "url": "https://github.com/penwell-app/draw-on/issues"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "prepare": "tsup"
    },
    "peerDependencies": {
        "react": ">=17"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^18.3.11",
        "tsup": "^8.3.0",
        "typescript": "^5.6.2"
    },
    "publishConfig": {
        "access": "public"
    }
}