{
    "name": "@penwell/draw-on",
    "version": "0.1.4",
    "description": "Animate any inline SVGs so its strokes draw themselves, then fade the fills and labels in. Scrubbable, and recordable to WebM in the browser.",
    "keywords": [
        "svg",
        "animation",
        "vivus",
        "draw",
        "handwriting",
        "react",
        "webm",
        "sketch",
        "reveal",
        "mermaid",
        "Excalidraw",
        "record",
        "scrubbable",
        "recordable",
        "webm"
    ],
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./core": {
            "import": {
                "types": "./dist/core.d.ts",
                "default": "./dist/core.js"
            },
            "require": {
                "types": "./dist/core.d.cts",
                "default": "./dist/core.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "demo-annotate.gif",
        "demo-diagram.gif",
        "demo-notebook.gif",
        "draw-on.svg"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/penwell-app/draw-on.git"
    },
    "homepage": "https://draw-on-nu.vercel.app/",
    "bugs": {
        "url": "https://github.com/penwell-app/draw-on/issues"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "prepare": "tsup"
    },
    "dependencies": {
        "vivus": "^0.4.6"
    },
    "peerDependencies": {
        "react": ">=17"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^18.3.11",
        "@types/vivus": "^0.4.7",
        "tsup": "^8.3.0",
        "typescript": "^5.6.2"
    },
    "publishConfig": {
        "access": "public"
    }
}