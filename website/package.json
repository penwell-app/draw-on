{
    "name": "draw-on-website",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Documentation, live demos and playground for @penwell/draw-on.",
    "scripts": {
        "dev": "vite",
        "install": "npm run install",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview --port 4180",
        "typecheck": "tsc --noEmit",
        "typecheck:package": "tsc -p ../tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/theme-one-dark": "^6.1.2",
        "@penwell/draw-on": "^0.1.4",
        "mermaid": "^12.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4",
        "shiki": "^4.4.3"
    },
    "devDependencies": {
        "@codemirror/lang-xml": "^6.1.0",
        "@eslint/js": "^10.0.1",
        "@mdx-js/rollup": "^3.1.1",
        "@shikijs/rehype": "^4.4.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/vivus": "^0.4.7",
        "@uiw/react-codemirror": "^4.25.11",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "jsdom": "^30.1.0",
        "mermaid": "^12.0.0",
        "remark-gfm": "^4.0.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vivus": "^0.4.6"
    }
}
